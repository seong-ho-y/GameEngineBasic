# --------------------------------------------
!Content/Share/
!Content/Share/**

!Content/Cyberp_RPG_UI_5_2/
!Content/Cyberp_RPG_UI_5_2/**

!Content/SciFi_ToiletMech/
!Content/SciFi_ToiletMech/**

!Content/StylizedProjectileVFX_Pack/
!Content/StylizedProjectileVFX_Pack/**

!Content/Fab/
!Content/Fab/**

!Content/Fab/Cruise_Missile_New_FBX_Sample/
!Content/Fab/Cruise_Missile_New_FBX_Sample/**

!Content/Fab/Sci-Fi_Crate/
!Content/Fab/Sci-Fi_Crate/**

!Content/ParagonMuriel/
!Content/ParagonMuriel/**

!Content/Drone_Scavenger/
!Content/Drone_Scavenger/**

!Content/SciFiturretasset/
!Content/SciFiturretasset/**

!Content/Free_Sounds_Pack/
!Content/Free_Sounds_Pack/**

